datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tournament {
  id      String   @id @default(uuid())
  name    String
  matches Match[]

  @@map("tournaments")
}

model Stadium {
  id      String    @id @default(uuid())
  name    String
  clubs   Club[]
  matches Match[]

  @@map("stadiums")
}

model Club {
  id             String        @id @default(uuid())
  name           String
  tacticalSystem String?       @map("tactical_system")
  stadiumId      String?       @map("stadium_id")
  stadium        Stadium?      @relation(fields: [stadiumId], references: [id])
  players        Player[]
  homeMatches    Match[]       @relation("HomeMatches")
  awayMatches    Match[]       @relation("AwayMatches")
  lineups        MatchLineup[]

  @@map("clubs")
}

model Player {
  id                 String        @id @default(uuid())
  name               String
  currentClubId      String?       @map("current_club_id")
  currentClub        Club?         @relation(fields: [currentClubId], references: [id])
  lineups            MatchLineup[] @relation("PlayerLineups")
  substitutedLineups MatchLineup[] @relation("SubstitutedLineups")
  stats              MatchStat[]

  @@map("players")
}

model Match {
  id           String        @id @default(uuid())
  tournamentId String        @map("tournament_id")
  tournament   Tournament    @relation(fields: [tournamentId], references: [id])
  matchday     Int
  date         DateTime
  homeClubId   String        @map("home_club_id")
  homeClub     Club          @relation("HomeMatches", fields: [homeClubId], references: [id])
  awayClubId   String        @map("away_club_id")
  awayClub     Club          @relation("AwayMatches", fields: [awayClubId], references: [id])
  stadiumId    String        @map("stadium_id")
  stadium      Stadium       @relation(fields: [stadiumId], references: [id])
  lineups      MatchLineup[]
  stats        MatchStat[]

  @@map("matches")
}

enum LineupStatus {
  titular
  suplente
  no_jugo
}

model MatchLineup {
  id                 String       @id @default(uuid())
  matchId            String       @map("match_id")
  match              Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId           String       @map("player_id")
  player             Player       @relation("PlayerLineups", fields: [playerId], references: [id])
  clubId             String       @map("club_id")
  club               Club         @relation(fields: [clubId], references: [id])
  isCalledUp         Boolean      @default(true) @map("is_called_up")
  status             LineupStatus
  minutesPlayed      Int          @default(0) @map("minutes_played")
  isSubstituted      Boolean      @default(false) @map("is_substituted")
  substitutedById    String?      @map("substituted_by_id")
  substitutedBy      Player?      @relation("SubstitutedLineups", fields: [substitutedById], references: [id])
  substitutionMinute Int?         @map("substitution_minute")

  @@map("match_lineups")
}

model MatchStat {
  id          String   @id @default(uuid())
  matchId     String   @map("match_id")
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId    String   @map("player_id")
  player      Player   @relation(fields: [playerId], references: [id])
  goals       Int      @default(0)
  assists     Int      @default(0)
  yellowCards Int      @default(0) @map("yellow_cards")
  redCard     Boolean  @default(false) @map("red_card")

  @@map("match_stats")
}
